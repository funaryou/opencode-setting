ZAI_API_KEY=your_zai_api_key_here

# Use the AI Gateway OpenAI-compatible root.
# Do not include /chat/completions here; opencode appends it automatically.
# Example: https://gateway.ai.cloudflare.com/v1/<accountID>/<gatewayID>/compat
CLOUDFLARE_WORKERS_AI_BASE_URL=https://gateway.ai.cloudflare.com/v1/<accountID>/<gatewayID>/compat
CLOUDFLARE_WORKERS_AI_API_KEY=your_cloudflare_api_key_here
