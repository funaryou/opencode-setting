  "mcp": {
    "gmail": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ],
      "enabled": true
    },
    "notebooklm": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@m4ykeldev/notebooklm-mcp",
        "serve"
      ],
      "env": {
        "HEADLESS": "false"
      },
      "enabled": true
    },
    "pdf": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@jztan/pdf-mcp"
      ],
      "enabled": true
    },
    "github": {
      "enabled": true,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "stitch": {
      "type": "local",
      "command": [
        "npx",
        "@_davideast/stitch-mcp",
        "proxy"
      ],
      "environment": {
        "STITCH_API_KEY": "{env:STITCH_API_KEY}"
      }
    },
    "pencil": {
      "command": [
        "/Users/fur-dev/.pencil/mcp/antigravity_ide/out/mcp-server-darwin-arm64",
        "--app",
        "antigravity_ide",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    }
  }
}